  "paths": {
    "/api/v1/memory/settings": {
      "get": {
        "summary": "Memory Settings",
        "operationId": "memory_settings_api_v1_memory_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Memory Patch Settings",
        "operationId": "memory_patch_settings_api_v1_memory_settings_patch",
        "requestBody": {
          "content": {
