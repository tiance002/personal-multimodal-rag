        "knowledge_base_id": "96a9eebd-ffb2-4bc6-9bea-3ed015845479",
        "filename": "e253bc4313c2daff90303f2865b6be0072dae2a515fefe1b8444172edeba21dc.txt",
        "text": "Pieter van Musschenbroek (14 March 1692 – 19 September 1761) was a Dutch scientist.\n He was a professor in Duisburg, Utrecht, and Leiden, where he held positions in mathematics, philosophy, medicine, and astronomy.\n He is credited with the invention of the first capacitor in 1746: the Leyden jar.\n He performed pioneering work on the buckling of compressed struts.\n",
        "chunk_index": 0,
        "start": 0,
        "end": 366,
        "source_version": "1bd681ce-5c23-43b5-b53f-3bc2fe194625",
        "chunk_type": "text",
        "page_number": null,
