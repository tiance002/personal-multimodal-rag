        "source_url": "/api/v1/knowledge-bases/96a9eebd-ffb2-4bc6-9bea-3ed015845479/documents/9d440f3c-021d-4c9b-adc5-6e7084fc8886/source"
      },
      "meta": {
        "request_id": "4cc70daa-e9fa-45f3-91ee-dfb0eae58442"
      }
    }
  },
  {
    "chunk_id": "41295870-5f65-458c-b045-85280c1184a3",
    "status": 200,
    "body": {
      "data": {
        "chunk_id": "41295870-5f65-458c-b045-85280c1184a3",
        "document_id": "a9aa34bf-0b2b-4bce-b0d4-fa1c18a8b253",
        "knowledge_base_id": "96a9eebd-ffb2-4bc6-9bea-3ed015845479",
        "filename": "613eaeec55c95427baf40b1483c3fd9f897530584be4d85da0033278ba4b5825.txt",
        "text": "A tribometer is an instrument that measures tribological quantities, such as coefficient of friction, friction force, and wear volume, between two surfaces in contact.\n It was invented by the 18th century Dutch scientist Musschenbroek",
        "chunk_index": 0,
        "start": 0,
        "end": 234,
        "source_version": "35d1280e-8347-4d97-a523-f0956a7c4a71",
