  {
    "chunk_id": "e8a751ff-032c-4c8c-bb31-4eddc73b3a86",
    "status": 200,
    "body": {
      "data": {
        "chunk_id": "e8a751ff-032c-4c8c-bb31-4eddc73b3a86",
        "document_id": "9d440f3c-021d-4c9b-adc5-6e7084fc8886",
        "knowledge_base_id": "96a9eebd-ffb2-4bc6-9bea-3ed015845479",
        "filename": "1c5fa1db320d59cba389daa592d258d7cd237eca31134a4f70efd152d7d06f4f.txt",
        "text": "A Leyden jar, or Leiden jar, is a device that \"stores\" static electricity between two electrodes on the inside and outside of a glass jar.\n A Leyden jar typically consists of a glass jar with metal foil cemented to the inside and the outside surfaces, and a metal terminal projecting vertically through the jar lid to make contact with the inner foil.\n It was the original form of a capacitor (originally known as a \"condenser\").",
        "chunk_index": 0,
        "start": 0,
        "end": 429,
        "source_version": "5663a72f-6cf2-4731-8820-dfbe286da82b",
        "chunk_type": "text",
        "page_number": null,
