INNER='\nimport hashlib,json,os\nfrom pathlib import Path\nimport psycopg\nfrom psycopg.rows import dict_row\ndef require(v,c):\n if not v:raise ValueError(c)\np=json.loads(Path(os.environ.get(\'S8_PRINCIPAL_FILE\',\'/run/secrets/principal.json\')).read_bytes());owner=p[\'subject_id\'];require(p[\'tenant_id\']==332 and hashlib.sha256(owner.encode()).hexdigest()==BEFORE[\'inventory\'][\'owner_sha256\'],\'POST_OWNER_TENANT_MISMATCH\')\nwith psycopg.connect(dbname=\'weknora_s8\',host=os.environ.get(\'S8_DB_HOST\',\'db\'),port=os.environ.get(\'S8_DB_PORT\',\'5432\'),user=os.environ.get(\'S8_DB_USER\',\'weknora\'),password=Path(os.environ.get(\'S8_DB_PASSWORD_FILE\',\'/run/secrets/database_password\')).read_text().strip(),autocommit=True,row_factory=dict_row,options=\'-c default_transaction_read_only=on -c statement_timeout=20000\') as c:\n c.execute(\'BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY\')\n try:\n  identity=c.execute(\'SELECT current_database() AS database,(pg_control_system()).system_identifier::text AS system_identifier\').fetchone();require(identity=={\'database\':\'weknora_s8\',\'system_identifier\':\'7698420805889187877\'},\'POST_PHYSICAL_PG_MISMATCH\')\n  request_ids=[e[\'request_id\'] for e in ENTRIES]\n  calls=c.execute(\'SELECT * FROM port_provider_calls WHERE tenant_id=332 AND subject_id=%s AND request_id=ANY(%s) ORDER BY request_id,capability,call_id\',(owner,request_ids)).fetchall()\n  actual={(r[\'request_id\'],r[\'capability\']):r for r in calls};expected={(r[\'request_id\'],r[\'capability\']):r for r in ENTRIES}\n  key_match=len(calls)==len(actual)==len(expected)==16 and set(actual)==set(expected)\n  row_match=key_match and all(r[\'outcome\']==\'RESPONSE_RECEIVED\' and r[\'finished_at\'] is not None and r[\'wire_sha256\']==expected[k][\'wire_sha256\'] and r[\'usage\']==expected[k][\'usage\'] for k,r in actual.items())\n  totals={field:sum(r[\'usage\'][field] for r in calls) for field in [\'prompt_tokens\',\'completion_tokens\',\'total_tokens\']}\n  breakdown={}\n  for r in calls:\n   key=r[\'provider\']+\'/\'+r[\'model\']+\'/\'+r[\'capability\'];v=breakdown.setdefault(key,{\'calls\':0,\'prompt_tokens\':0,\'completion_tokens\':0,\'total_tokens\':0});v[\'calls\']+=1\n   for field in totals:v[field]+=r[\'usage\'][field]\n  turns=c.execute(\'SELECT * FROM port_turns WHERE tenant_id=332 AND subject_id=%s AND client_request_id=ANY(%s) ORDER BY client_request_id\',(owner,list(TURNS))).fetchall()\n  turn_match=len(turns)==3 and all(t[\'status\']==\'completed\' and t[\'q0\']==TURNS[t[\'client_request_id\']][\'question\'] and t[\'knowledge_base_scope\']==TURNS[t[\'client_request_id\']][\'kb\'] and t[\'document_scope\']==[] for t in turns)\n  sources={}\n  for kb in BEFORE[\'inventory\'][\'source_fingerprints\']:\n   sources[kb]={}\n   for table,field in [(\'knowledges\',\'knowledge_base_id\'),(\'chunks\',\'knowledge_base_id\')]:sources[kb][table]=c.execute(\'SELECT count(*) AS count,md5(string_agg(md5(row_to_json(t)::text),\\\'\\\' ORDER BY id)) AS fingerprint FROM \'+table+\' t WHERE tenant_id=332 AND \'+field+\'=%s\',(kb,)).fetchone()\n  unknown=c.execute("SELECT count(*) AS count,md5(string_agg(md5(row_to_json(t)::text),\'\' ORDER BY call_id)) AS fingerprint FROM port_provider_calls t WHERE outcome=\'UNKNOWN\'").fetchone()\n  current_docs=[]\n  for doc,scope in DOCS.items():\n   row=c.execute("SELECT id,knowledge_base_id,tenant_id,parse_status,enable_status,metadata->>\'source_version\' AS source_version,metadata->>\'sha256\' AS source_sha256 FROM knowledges WHERE tenant_id=332 AND id=%s AND knowledge_base_id=%s AND deleted_at IS NULL",(doc,scope[\'kb\'])).fetchone();current_docs.append(row)\n  doc_match=all(r and r[\'parse_status\']==\'completed\' and r[\'enable_status\']==\'enabled\' and r[\'source_version\']==DOCS[r[\'id\']][\'version\'] and r[\'source_sha256\']==DOCS[r[\'id\']][\'sha256\'] for r in current_docs)\n  kbs=sorted(set(BEFORE[\'inventory\'][\'source_fingerprints\'])|{v[\'kb\'] for v in DOCS.values()});consent=c.execute(\'SELECT id,tenant_id,cloud_allowed FROM knowledge_bases WHERE tenant_id=332 AND id=ANY(%s) AND deleted_at IS NULL ORDER BY id\',(kbs,)).fetchall()\n finally:c.execute(\'ROLLBACK\')\nchecks={\'pg_unique_request_id_capability_equal_16\':key_match,\'pg_outcome_usage_wire_exactly_match_child_ledgers\':row_match,\'three_completed_turns_q0_scope_exact\':turn_match,\'captured_source_fingerprints_unchanged\':sources==BEFORE[\'inventory\'][\'source_fingerprints\'],\'historical_unknown_fingerprint_unchanged\':unknown==BEFORE[\'inventory\'][\'old_unknown\'],\'current_vision_copy_version_hash_state_unchanged\':doc_match,\'current_all4_kb_cloud_allowed\':len(consent)==4 and all(r[\'cloud_allowed\'] for r in consent)}\nprint(json.dumps({\'status\':\'POST_RUN_READ_ONLY_PG_RECONCILED\' if all(checks.values()) else \'POST_RUN_GUARD_FAILURE\',\'checks\':checks,\'usage_totals\':totals,\'usage_breakdown\':breakdown,\'database_identity\':identity,\'provider_calls_rows\':calls,\'turn_rows\':turns,\'source_fingerprints\':sources,\'old_unknown\':unknown,\'vision_current_documents\':current_docs,\'current_kb_consent\':consent,\'readback_generated_provider_calls\':0,\'database_writes\':0,\'transaction_end\':\'ROLLBACK\'},default=str))\n'

from pathlib import Path
import hashlib,json,subprocess
current=[]
for service,expected in zip(('api','worker'),BEFORE['production']):
 ids=subprocess.check_output(['docker','ps','-q','--filter','label=com.docker.compose.project=rag-s8','--filter','label=com.docker.compose.service='+service]).decode().split();assert len(ids)==1
 v=json.loads(subprocess.check_output(['docker','inspect',ids[0]]))[0];current.append({'id':v['Id'],'image_id':v['Image'],'running':v['State']['Running'],'restarts':v['RestartCount'],'compose_service':v['Config']['Labels']['com.docker.compose.service']})
entries=[]
for file in FILES:
 data=json.loads(Path(file).read_bytes());assert data['status']=='OPEN' and all(r['status']=='SETTLED' for r in data['entries']);entries.extend(data['entries'])
payload='BEFORE='+repr(BEFORE)+'\nENTRIES='+repr(entries)+'\nTURNS='+repr(TURNS)+'\nDOCS='+repr(DOCS)+'\n'+INNER
r=subprocess.run(['docker','exec','-i',current[0]['id'],'python','-B','-'],input=payload.encode(),capture_output=True)
if r.returncode:
 print(json.dumps({'status':'BLOCKED','code':'POST_RUN_READBACK_FAILED','stderr_sha256':hashlib.sha256(r.stderr).hexdigest(),'provider_calls':0}));raise SystemExit(1)
v=json.loads(r.stdout);hashes={p:hashlib.sha256(Path(p).read_bytes()).hexdigest() for p in BEFORE['config_hashes']}
v['production']=current;v['config_hashes']=hashes;v['checks']['production_ids_images_restart_counts_unchanged']=current==BEFORE['production'];v['checks']['production_compose_runtime_files_unchanged']=hashes==BEFORE['config_hashes']
v['status']='POST_RUN_ALL_CAPTURED_GUARDS_PASS' if all(v['checks'].values()) else 'POST_RUN_GUARD_FAILURE'
print(json.dumps(v))
