    "sources": [
      {
        "id": "77918834-4eaa-4505-a85b-143114dcf170",
        "knowledge_id": "4d35e306-4a19-470b-bf68-93731539439d",
        "chunk_type": "text",
        "parent_chunk_id": null,
        "content": "Franklin bells (also known as Gordon’s Bells or lightning bells) are an early demonstration of electric charge designed to work with a Leyden jar.\n Franklin bells are only a qualitative indicator of electric charge and were used for simple demonstrations rather than research.\n This was the first device that converted electrical energy into mechanical energy in the form of continuous mechanical motion, in this case, the moving of a bell clapper back and forth between two oppositely charged bells.",
        "start_at": 0,
        "end_at": 500,
        "metadata": {
          "source_filename": "b6cc805398afebfa8327.txt",
          "source_version": "9bce2280-59e7-4d9d-97d5-98820b8adfb3",
          "parsed_source_id": "4d35e306-4a19-470b-bf68-93731539439d:child:0"
        },
        "context_header": ""
      },
      {
        "id": "cd592c2d-0974-4a72-bdb9-d0c1dd765822",
        "knowledge_id": "734d37f7-40bc-4b75-a44b-e7ce30562c0f",
        "chunk_type": "text",
        "parent_chunk_id": null,
        "content": "A Leyden jar, or Leiden jar, is a device that \"stores\" static electricity between two electrodes on the inside and outside of a glass jar.\n A Leyden jar typically consists of a glass jar with metal foil cemented to the inside and the outside surfaces, and a metal terminal projecting vertically through the jar lid to make contact with the inner foil.\n It was the original form of a capacitor (originally known as a \"condenser\").",
        "start_at": 0,
        "end_at": 429,
