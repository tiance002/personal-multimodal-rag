RAG_HOST=127.0.0.1
RAG_PORT=8000
RAG_CLOUD_ENABLED=false
RAG_LOCAL_QUERY_ENABLED=false
RAG_RETRIEVAL_MODE=adaptive
RAG_LOCAL_ANSWER_ENABLED=true
# The following optional adapters are not implemented in V1; enabling them fails explicitly.
RAG_RERANK_ENABLED=false
RAG_MMR_ENABLED=false
RAG_QUERY_REWRITE_ENABLED=false
RAG_CLOUD_FALLBACK_ENABLED=false
RAG_LANGFUSE_ENABLED=false
RAG_LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Use either the separate public/secret keys below, or a Basic-encoded pk-lf:sk-lf value.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_AUTHORIZATION=
RAG_STORAGE_ROOT=var/storage
RAG_DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:55432/rag
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:4b
OLLAMA_EMBEDDING_MODEL=bge-m3:latest
# Compose containers reach the host Ollama through this separate address.
COMPOSE_OLLAMA_BASE_URL=http://host.docker.internal:11434
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=55432
# RuleRouter draft-v0.4; routing does not authorize cloud access. P5 real roles
# remain BLOCKED_REAL until a separate reviewed authorization/capacity binding.
RAG_RULE_ROUTER_ENABLED=false
RAG_RULE_ROUTER_QUALITY_ESCALATION=true
RAG_RULE_ROUTER_ABSTENTION_ESCALATION=false
RAG_RULE_ROUTER_PROVIDER_FALLBACK=false
