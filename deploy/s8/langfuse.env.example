# S8 telemetry is independently opt-in; these flags do not authorize models.
RAG_LANGFUSE_ENABLED=false
RAG_LANGFUSE_EGRESS_ENABLED=false
RAG_LANGFUSE_CAPTURE_CONTENT=false
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=default
LANGFUSE_RELEASE=unversioned

# Inject through an existing private environment OR explicitly mounted files.
# Never commit populated keys or copy a private .env into an image.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY_FILE=
LANGFUSE_SECRET_KEY_FILE=
LANGFUSE_AUTHORIZATION_FILE=
