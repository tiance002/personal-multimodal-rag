FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml ./
COPY backend/__init__.py ./backend/__init__.py
COPY backend/weknora_port ./backend/weknora_port
COPY eval_center ./eval_center
RUN pip install --no-cache-dir '.[weknora-port]'
CMD ["weknora-python-api", "--host", "0.0.0.0", "--port", "8000"]
